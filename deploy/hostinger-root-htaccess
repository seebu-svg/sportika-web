# ─────────────────────────────────────────────────────────────────────────────
# Hostinger root .htaccess
# ─────────────────────────────────────────────────────────────────────────────
# Place this file in the root of your Hostinger public_html (or domain root).
# It redirects ALL traffic into the Laravel project's /public folder.
#
# If you upload the project to a subfolder (e.g. public_html/sportika),
# change the RewriteRule target accordingly:
#   RewriteRule ^(.*)$ /sportika/public/$1 [L]
# ─────────────────────────────────────────────────────────────────────────────

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (uncomment if your domain has an SSL certificate)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Redirect everything to the Laravel public directory
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# ── Security: block access to sensitive files ────────────────────────────────
<FilesMatch "\.(env|git|json|lock|log|md|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Disable directory listing
Options -Indexes

# Disable server signature
ServerSignature Off
