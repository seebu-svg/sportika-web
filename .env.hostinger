# ─────────────────────────────────────────────────────────────────────────────
# Sportika — Hostinger Production Environment
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env on your Hostinger server and fill in the values.
# Generate an app key:  php artisan key:generate
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=Sportika
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database (Hostinger MySQL) ───────────────────────────────────────────────
# Create the database and user from hPanel → Databases → MySQL Databases.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_sportika
DB_USERNAME=u123456789_sportika
DB_PASSWORD=your_strong_password_here

# ── Session / Cache / Queue ──────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=yourdomain.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file

# ── Mail (Hostinger SMTP or external) ────────────────────────────────────────
# Option A — Hostinger SMTP:
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_email_password
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Option B — leave as log until mail is configured:
# MAIL_MAILER=log

# ── Vite ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
